# DolphinBench environment variables. Copy to `.env` in the repo root and fill in.
#
# DolphinBench-specific runtime controls use the DOLPHINBENCH_ prefix.
# Older ENACT_ settings remain readable when the matching new key is absent.

# =============================================================================
# LLM access (required — pick at least one)
# =============================================================================

# OpenAI API key. Used by examples/openai_direct_driver.py.
OPENAI_API_KEY=...

# Override the model used by openai_direct_driver (default: gpt-4o-mini).
# OPENAI_MODEL=gpt-4o-mini

# Override the OpenAI base URL — useful for Azure OpenAI or OpenRouter.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic API key. Not required by the core harness (urllib + Azure path
# works for the llm-judge grader), but you can wire it into your own
# Claude-backed driver.
# ANTHROPIC_API_KEY=...

# Claude Code subscription token used only by the isolated Claude benchmark
# driver. Generate it with `claude setup-token`. Do not combine this with an
# Anthropic API key in the same benchmark job.
# CLAUDE_CODE_OAUTH_TOKEN=...

# =============================================================================
# LLM-judge grader (optional — only needed if you run llm_judge tests)
# =============================================================================

# Backend: "openai" (default, OpenAI-compatible including OpenRouter) or
# "azure" (Azure OpenAI with deployment routing).
# DOLPHINBENCH_JUDGE_BACKEND=openai

# Which env var holds the judge API key. Default: OPENROUTER_API_KEY.
# Set to OPENAI_API_KEY if you want to use OpenAI proper.
# DOLPHINBENCH_JUDGE_KEY_ENV=OPENROUTER_API_KEY
# OPENROUTER_API_KEY=...

# Judge model + endpoint overrides.
# DOLPHINBENCH_JUDGE_MODEL=openai/gpt-4o-mini
# DOLPHINBENCH_JUDGE_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
# DOLPHINBENCH_JUDGE_MAX_TOKENS=8000

# Azure OpenAI (only if DOLPHINBENCH_JUDGE_BACKEND=azure).
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=...
# DOLPHINBENCH_JUDGE_DEPLOYMENT=gpt-5.6-sol
# DOLPHINBENCH_JUDGE_REASONING_EFFORT=medium
# DOLPHINBENCH_JUDGE_API_VERSION=2024-08-01-preview

# =============================================================================
# Mock MCP server (optional)
# =============================================================================

# Port the launch script binds to when running mock_mcp in HTTP/SSE mode.
# Default 3001. Most integrated drivers spawn the server as a stdio subprocess
# and do not consult this value.
MCP_PORT=3001

# Transport when running mock_mcp/server.py directly. One of:
#   stdio
#   sse
#   streamable-http
# DOLPHINBENCH_MCP_TRANSPORT=streamable-http

# Override paths if you want isolated test runs.
# DOLPHINBENCH_STATE_PATH=/tmp/dolphinbench_state.json
# DOLPHINBENCH_LOG_PATH=/tmp/dolphinbench_calls.jsonl
# DOLPHINBENCH_RUN_ID=my-run

# =============================================================================
# Local HTTP agent integration (optional)
# =============================================================================

# Local HTTP API host/port. Defaults are shown.
MAGENT_HOST=127.0.0.1
MAGENT_PORT=8741

# Auth token for the local HTTP agent, if your setup requires one.
# MAGENT_AUTH_TOKEN=...

# Override the model reported for cost instrumentation.
# MAGENT_MODEL_ID=claude-sonnet-4-5

# =============================================================================
# hermes integration (optional — only if you run --provider builtin/honcho/mem0)
# =============================================================================

# Path to the Hermes binary, if it is not on PATH.
# HERMES_BIN=/usr/local/bin/hermes

# Override the model used by hermes for cost instrumentation (default: gpt-5).
# HERMES_MODEL_ID=gpt-5

# Cloud memory-provider credentials — only if you use those profiles.
# HONCHO_API_KEY=...
# MEM0_API_KEY=...
# MEM0_ORGANIZATION_ID=...
# MEM0_PROJECT_ID=...
# HINDSIGHT_API_KEY=...
# SUPERMEMORY_API_KEY=...
