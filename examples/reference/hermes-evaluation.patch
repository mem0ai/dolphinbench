@@ -0,0 +1,171 @@
+import json
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, MagicMock
+
+from plugins.memory.hindsight import (
+    HindsightMemoryProvider,
+    RECALL_SCHEMA,
+    REFLECT_SCHEMA,
+)
+from plugins.memory.honcho import (
+    CONTEXT_SCHEMA as HONCHO_CONTEXT_SCHEMA,
+    PROFILE_SCHEMA as HONCHO_PROFILE_SCHEMA,
+    REASONING_SCHEMA as HONCHO_REASONING_SCHEMA,
+    SEARCH_SCHEMA as HONCHO_SEARCH_SCHEMA,
+    HonchoMemoryProvider,
+)
+from plugins.memory.mem0 import Mem0MemoryProvider, SEARCH_SCHEMA as MEM0_SEARCH_SCHEMA
+from plugins.memory.supermemory import (
+    PROFILE_SCHEMA,
+    SEARCH_SCHEMA,
+    SupermemoryMemoryProvider,
+)
+
+
+def test_hindsight_seed_uses_stable_id_and_records_success(monkeypatch, tmp_path):
+    receipts = tmp_path / "hindsight.jsonl"
+    monkeypatch.setenv("DOLPHINBENCH_HINDSIGHT_SEED_RECEIPTS", str(receipts))
+    monkeypatch.setenv("DOLPHINBENCH_SEED_ITEM_ID", "session-1:0")
+
+    config_path = tmp_path / "hindsight" / "config.json"
+    config_path.parent.mkdir(parents=True)
+    config_path.write_text(json.dumps({
+        "mode": "cloud",
+        "apiKey": "test-key",
+        "api_url": "http://localhost:9999",
+        "bank_id": "morgan",
+        "memory_mode": "hybrid",
+        "retain_async": False,
+    }))
+    monkeypatch.setattr(
+        "plugins.memory.hindsight.get_hermes_home", lambda: tmp_path
+    )
+    provider = HindsightMemoryProvider()
+    provider.initialize(
+        session_id="hermes-session", hermes_home=str(tmp_path), platform="cli"
+    )
+    client = MagicMock()
+    client.aretain_batch = AsyncMock(return_value=SimpleNamespace())
+    client.aclose = AsyncMock()
+    provider._client = client
+
+    provider.sync_turn("user text", "assistant text", session_id="hermes-session")
+
+    assert client.aretain_batch.call_args.kwargs["document_id"] == "session-1:0"
+    assert client.aretain_batch.call_args.kwargs["retain_async"] is False
+    rows = [json.loads(line) for line in receipts.read_text().splitlines()]
+    assert rows[0]["provider"] == "hindsight"
+    assert rows[0]["seed_item_id"] == "session-1:0"
+
+
+def test_hindsight_read_only_exposes_only_read_tools(monkeypatch):
+    monkeypatch.setenv("DOLPHINBENCH_MEMORY_READ_ONLY", "1")
+    provider = HindsightMemoryProvider()
+    assert provider.get_tool_schemas() == [RECALL_SCHEMA, REFLECT_SCHEMA]
+
+
+class _SupermemoryClient:
+    def __init__(self):
+        self.calls = []
+
+    def ingest_conversation(self, session_id, messages, metadata=None):
+        self.calls.append((session_id, messages, metadata))
+
+
+def test_supermemory_seed_uses_stable_id_once_and_records_success(monkeypatch, tmp_path):
+    receipts = tmp_path / "supermemory.jsonl"
+    monkeypatch.setenv("DOLPHINBENCH_SUPERMEMORY_SEED_RECEIPTS", str(receipts))
+    monkeypatch.setenv("DOLPHINBENCH_SEED_ITEM_ID", "session-2:1")
+
+    provider = SupermemoryMemoryProvider()
+    provider._active = True
+    provider._write_enabled = True
+    provider._session_id = "hermes-session"
+    provider._container_tag = "morgan"
+    provider._client = _SupermemoryClient()
+    messages = [
+        {"role": "user", "content": "user text"},
+        {"role": "assistant", "content": "assistant text"},
+    ]
+
+    provider.on_session_end(messages)
+    provider.on_session_end(messages)
+
+    assert len(provider._client.calls) == 1
+    assert provider._client.calls[0][0] == "session-2:1"
+    rows = [json.loads(line) for line in receipts.read_text().splitlines()]
+    assert rows[0]["provider"] == "supermemory"
+    assert rows[0]["seed_item_id"] == "session-2:1"
+
+
+def test_supermemory_read_only_exposes_only_read_tools(monkeypatch):
+    monkeypatch.setenv("DOLPHINBENCH_MEMORY_READ_ONLY", "1")
+    provider = SupermemoryMemoryProvider()
+    assert provider.get_tool_schemas() == [SEARCH_SCHEMA, PROFILE_SCHEMA]
