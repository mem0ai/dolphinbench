index 0000000000000000000000000000000000000000..4dfef6ad934775a019101db9022d9ccc82dc38f7
--- /dev/null
+++ b/agent/benchmark_memory.py
@@ -0,0 +1,76 @@
+"""Small helpers used only by DolphinBench memory ingestion and evaluation."""
+
+from __future__ import annotations
+
+import json
+import os
+from pathlib import Path
+from typing import Any
+
+
+def env_true(name: str) -> bool:
+    return os.environ.get(name, "").strip().lower() in {"1", "true", "yes", "on"}
+
+
+def memory_is_read_only(provider: str) -> bool:
+    return env_true("DOLPHINBENCH_MEMORY_READ_ONLY") or env_true(
+        f"DOLPHINBENCH_{provider.upper()}_READ_ONLY"
+    )
+
+
+def seed_item(receipt_env: str) -> tuple[Path, str] | None:
+    receipt_path = os.environ.get(receipt_env, "").strip()
+    item_id = os.environ.get("DOLPHINBENCH_SEED_ITEM_ID", "").strip()
+    if not receipt_path or not item_id:
+        return None
+    return Path(receipt_path), item_id
+
+
+def seed_item_has_receipt(receipt_env: str, provider: str) -> bool:
+    value = seed_item(receipt_env)
+    if value is None:
+        return False
+    path, item_id = value
+    try:
+        lines = path.read_text(encoding="utf-8").splitlines()
+    except FileNotFoundError:
+        return False
+    for line in lines:
+        if not line.strip():
+            continue
+        record = json.loads(line)
+        if (
+            record.get("provider") == provider
+            and record.get("operation_kind") == "automatic_sync_turn"
+            and record.get("seed_item_id") == item_id
+        ):
+            return True
+    return False
+
+
+def write_seed_receipt(
+    receipt_env: str,
+    provider: str,
+    *,
+    details: dict[str, Any],
+) -> None:
+    value = seed_item(receipt_env)
+    if value is None:
+        return
+    path, item_id = value
+    path.parent.mkdir(parents=True, exist_ok=True)
+    record = {
+        "receipt_type": "memory_seed_operation",
+        "provider": provider,
+        "operation_kind": "automatic_sync_turn",
+        "seed_item_id": item_id,
+        **details,
+    }
+    payload = (json.dumps(record, sort_keys=True, separators=(",", ":")) + "\n").encode()
+    fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
+    try:
+        written = os.write(fd, payload)
+        if written != len(payload):
+            raise OSError(f"short receipt write: {written}/{len(payload)} bytes")
+    finally:
+        os.close(fd)
